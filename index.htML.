
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHAPCHAP ESPACE PRO</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f6f5;color:#173b32}
header{background:#123e32;color:white;padding:24px}
header h1{margin:0;font-size:25px}
header p{color:#c8ded5}
main{max-width:950px;margin:30px auto;padding:15px}
.card{background:white;padding:25px;border-radius:16px;margin-bottom:18px;box-shadow:0 4px 15px #0000000c}
h2{margin-top:0}
input,select{width:100%;padding:14px;margin:8px 0 16px;border:1px solid #ddd;border-radius:9px;font-size:16px}
button{background:#16845f;color:white;border:0;padding:14px 20px;border-radius:9px;font-size:16px;cursor:pointer}
button:hover{background:#106849}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.stat{background:#e8f4ed;padding:18px;border-radius:12px}
.stat strong{font-size:25px;display:block;margin-top:8px}
.hidden{display:none}
footer{text-align:center;color:#777;padding:25px}
@media(max-width:600px){.stats{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
<h1>CHAPCHAP NETTOYAGE</h1>
<p>ESPACE PROFESSIONNEL</p>
</header>
<main>
<section class="card" id="login">
<h2>Bienvenue dans votre espace</h2>
<p>Connectez-vous pour accéder à votre activité.</p>
<label>Adresse e-mail</label>
<input id="email" type="email" placeholder="Votre adresse e-mail">
<label>Votre fonction</label>
<select id="role">
<option value="directeur">Directeur</option>
<option value="agent">Agent de nettoyage</option>
<option value="commercial">Commercial</option>
</select>
<button onclick="connexion()">Accéder à l’espace</button>
<p id="message"></p>
</section>

<section class="hidden" id="dashboard">
<div class="card">
<h2 id="bonjour">Tableau de bord</h2>
<p>Bienvenue dans CHAPCHAP ESPACE PRO.</p>
</div>
<div class="stats">
<div class="stat">Missions<strong>0</strong></div>
<div class="stat">Clients<strong>0</strong></div>
<div class="stat">Interventions<strong>0</strong></div>
</div>
<div class="card">
<h2>Gestion de l’activité</h2>
<p>Planning des interventions</p>
<p>Suivi des agents</p>
<p>Gestion des clients et prospects</p>
<p>Suivi des missions</p>
<p>Rapports d’activité</p>
</div>
<button onclick="deconnexion()">Se déconnecter</button>
</section>
</main>
<footer>© CHAPCHAP NETTOYAGE — Espace professionnel</footer>
<script>
function connexion(){
const email=document.getElementById('email').value;
const role=document.getElementById('role').value;
if(!email.includes('@')){
document.getElementById('message').textContent="Veuillez saisir une adresse e-mail valide.";
return;
}
document.getElementById('login').classList.add('hidden');
document.getElementById('dashboard').classList.remove('hidden');
document.getElementById('bonjour').textContent="Bonjour — "+role;
}
function deconnexion(){
document.getElementById('dashboard').classList.add('hidden');
document.getElementById('login').classList.remove('hidden');
}
</script>
</body>
</html>
